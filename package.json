{
  "name": "mindmap-cli",
  "version": "0.2.0",
  "private": true,
  "description": "A local directed-graph CLI for independent human and agent reads and transactional edits.",
  "type": "module",
  "bin": {
    "mindmap": "bin/mindmap.js"
  },
  "engines": {
    "node": "24.15.0"
  },
  "files": [
    "bin/",
    "dist/",
    "schemas/",
    "docs/",
    "skills/",
    "samples/",
    "README.md",
    "assets/"
  ],
  "scripts": {
    "build:html": "npm --prefix app run build",
    "check:html": "npm --prefix app run check",
    "test:html": "npm --prefix app test",
    "build": "node scripts/build.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "test:package": "node scripts/package-acceptance.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fontkit": "2.0.4",
    "koffi": "3.2.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "jsdom": "30.0.1",
    "mermaid": "11.17.2"
  }
}
