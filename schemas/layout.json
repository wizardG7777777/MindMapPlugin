{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mindmap-cli:contract:1:layout",
  "type": "object",
  "properties": {
    "layoutVersion": {
      "const": 1
    },
    "profile": {
      "enum": [
        "flowchart",
        "mindmap",
        "dependency",
        "network",
        "fishbone"
      ]
    },
    "orientation": {
      "enum": [
        "TD",
        "LR"
      ]
    },
    "entryNodeId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "width": {
      "type": "number",
      "minimum": 0
    },
    "height": {
      "type": "number",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "title": {
            "type": "string"
          },
          "role": {
            "enum": [
              "start",
              "action",
              "decision",
              "merge",
              "end",
              "error"
            ]
          },
          "shape": {
            "enum": [
              "round",
              "rect",
              "diamond"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "role",
          "shape",
          "x",
          "y",
          "width",
          "height",
          "rank",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "kind": {
            "type": "string"
          },
          "role": {
            "enum": [
              "forward",
              "branch",
              "error",
              "retry",
              "cross",
              "cycle"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "label": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "minimum": 0
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height",
              "lines"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "kind",
          "role",
          "points",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "alternatives",
              "cycle"
            ]
          },
          "nodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "maxLength": 128
            }
          },
          "entryNodeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "mergeNodeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "nodeIds",
          "entryNodeId",
          "mergeNodeId"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "sameRank": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "maxLength": 128
                }
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "nodeIds",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "forwardEdgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          }
        },
        "retryEdgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          }
        },
        "secondaryEdgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          }
        }
      },
      "required": [
        "sameRank",
        "forwardEdgeIds",
        "retryEdgeIds",
        "secondaryEdgeIds"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "nodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "maxLength": 128
            }
          },
          "edgeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "maxLength": 128
            }
          }
        },
        "required": [
          "code",
          "message",
          "nodeIds",
          "edgeIds"
        ],
        "additionalProperties": false
      }
    },
    "font": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "family",
        "version",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "layoutVersion",
    "profile",
    "orientation",
    "entryNodeId",
    "width",
    "height",
    "nodes",
    "edges",
    "groups",
    "constraints",
    "warnings",
    "font"
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "flowNode": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "start",
            "action",
            "decision",
            "merge",
            "end",
            "error"
          ]
        },
        "mergeNodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        }
      },
      "required": [
        "role"
      ],
      "additionalProperties": false
    },
    "flowEdge": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "forward",
            "branch",
            "error",
            "retry"
          ]
        }
      },
      "required": [
        "role"
      ],
      "additionalProperties": false
    }
  }
}
