{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mindmap-cli:contract:1:operations",
  "type": "object",
  "properties": {
    "envelopeVersion": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "baseGraphVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "system"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "document"
            },
            "allowDelete": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "allowDelete"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "ids"
            },
            "nodeIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "uniqueItems": true
            },
            "edgeIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "uniqueItems": true
            },
            "allowDelete": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "nodeIds",
            "edgeIds",
            "allowDelete"
          ],
          "additionalProperties": false
        }
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "addNode"
              },
              "node": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "cardContent": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/jsonValue"
                    }
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "node"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "updateNode"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "patch": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "cardContent": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/jsonValue"
                    }
                  }
                },
                "required": [],
                "additionalProperties": false,
                "minProperties": 1
              }
            },
            "required": [
              "type",
              "nodeId",
              "patch"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "removeNode"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "edgePolicy": {
                "const": "removeIncidentEdges"
              }
            },
            "required": [
              "type",
              "nodeId",
              "edgePolicy"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "addEdge"
              },
              "edge": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128
                  },
                  "kind": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/jsonValue"
                    }
                  }
                },
                "required": [
                  "id",
                  "source",
                  "target",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "edge"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "updateEdge"
              },
              "edgeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "patch": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128
                  },
                  "kind": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "order": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/jsonValue"
                    }
                  }
                },
                "required": [],
                "additionalProperties": false,
                "minProperties": 1
              }
            },
            "required": [
              "type",
              "edgeId",
              "patch"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "removeEdge"
              },
              "edgeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              }
            },
            "required": [
              "type",
              "edgeId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "setEntryNode"
              },
              "nodeId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "nodeId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "reorderEdges"
              },
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "kind": {
                "type": "string",
                "pattern": "\\S"
              },
              "edgeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "maxLength": 128
                },
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "source",
              "kind",
              "edgeIds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "updateDocument"
              },
              "patch": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "semanticType": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [],
                "additionalProperties": false,
                "minProperties": 1
              }
            },
            "required": [
              "type",
              "patch"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "envelopeVersion",
    "documentId",
    "baseGraphVersion",
    "operationId",
    "scope",
    "operations"
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
