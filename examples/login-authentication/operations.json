{
  "envelopeVersion": 1,
  "documentId": "login-authentication",
  "baseGraphVersion": 0,
  "operationId": "build-login-authentication-v1",
  "actor": {
    "kind": "agent",
    "name": "Codex"
  },
  "scope": {
    "mode": "document",
    "allowDelete": false
  },
  "operations": [
    {
      "type": "addNode",
      "node": {
        "id": "login_ui",
        "title": "用户看到登录界面",
        "cardContent": "展示 A、B、C 三种登录入口。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "choose_method",
        "title": "用户选择登录方式",
        "cardContent": "A 为本系统账号密码登录；B、C 为对应平台鉴权。",
        "notes": "",
        "meta": {
          "owner": "user"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "a_input",
        "title": "A：输入账号和密码",
        "cardContent": "仅 A 方式在本系统收集账号和密码。",
        "notes": "",
        "meta": {
          "owner": "frontend",
          "loginMethod": "A",
          "collectsAccountAndPassword": true
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "a_form_check",
        "title": "A：检查必填项与格式",
        "cardContent": "前端检查输入是否完整、格式是否符合要求；不承担身份鉴权。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "a_input_error",
        "title": "提示输入问题",
        "cardContent": "标出需要修正的输入，返回账号密码表单。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "a_verify",
        "title": "A：服务端校验账号密码",
        "cardContent": "提交至本系统登录接口，由服务端验证账号及密码。",
        "notes": "",
        "meta": {
          "owner": "backend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "a_auth_error",
        "title": "A：提示账号或密码错误",
        "cardContent": "保留在 A 登录流程，允许重新输入。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "b_authorize",
        "title": "B：发起平台 B 授权",
        "cardContent": "通过平台 B 的登录 SDK 或授权流程取得待验证的平台凭证；本系统不收集平台密码。",
        "notes": "",
        "meta": {
          "owner": "platform_b",
          "loginMethod": "B",
          "collectsAccountAndPassword": false
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "b_verify",
        "title": "B：服务端调用平台 B API 鉴权",
        "cardContent": "按平台 B 规范验证或交换凭证，并获取经验证的平台用户身份；不信任客户端自行宣称的身份。",
        "notes": "",
        "meta": {
          "owner": "backend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "c_authorize",
        "title": "C：发起平台 C 授权",
        "cardContent": "通过平台 C 的登录 SDK 或授权流程取得待验证的平台凭证；本系统不收集平台密码。",
        "notes": "",
        "meta": {
          "owner": "platform_c",
          "loginMethod": "C",
          "collectsAccountAndPassword": false
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "c_verify",
        "title": "C：服务端调用平台 C API 鉴权",
        "cardContent": "按平台 C 规范验证或交换凭证，并获取经验证的平台用户身份。",
        "notes": "",
        "meta": {
          "owner": "backend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "platform_error",
        "title": "提示平台登录未完成",
        "cardContent": "覆盖用户取消、拒绝授权、凭证无效及 API 超时或失败；允许重新选择方式。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "resolve_account",
        "title": "确认对应的本地账号",
        "cardContent": "将通过鉴权的身份映射到本地账号。首次平台登录的创建或绑定方式由业务规则决定，不在本示意图中指定具体策略。",
        "notes": "",
        "meta": {
          "owner": "backend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "account_check",
        "title": "检查本地账号是否可登录",
        "cardContent": "检查账号状态及业务准入条件。",
        "notes": "",
        "meta": {
          "owner": "backend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "account_error",
        "title": "提示账号不可用或关联失败",
        "cardContent": "不创建登录会话；展示原因并允许返回登录入口。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "issue_session",
        "title": "服务端建立本系统登录会话",
        "cardContent": "身份和账号检查通过后，建立本系统会话并返回登录结果；平台凭证不直接等同于本系统会话。",
        "notes": "",
        "meta": {
          "owner": "backend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "session_error",
        "title": "提示登录服务暂时失败",
        "cardContent": "会话未建立时不进入主界面，允许重新发起登录。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "accept_session",
        "title": "客户端确认登录成功",
        "cardContent": "按本系统会话机制接收登录态，开始初始化用户环境。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "load_context",
        "title": "加载用户资料与权限",
        "cardContent": "携带本系统会话请求用户资料、权限和主界面必需数据；服务端校验会话。",
        "notes": "",
        "meta": {
          "owner": "frontend_backend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "load_error",
        "title": "显示初始化失败并提供重试",
        "cardContent": "网络或服务暂时失败时保留加载状态，不误报已进入主界面。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "clear_session",
        "title": "清理失效登录态",
        "cardContent": "初始化过程中会话失效或未通过验证，清理本地登录状态并返回登录页。",
        "notes": "",
        "meta": {
          "owner": "frontend"
        }
      }
    },
    {
      "type": "addNode",
      "node": {
        "id": "main_ui",
