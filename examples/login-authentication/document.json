{"JSON-SchemaVersion":2,"metadata":{"id":"login-authentication","title":"用户登录鉴权模块流程示意图","graphVersion":2,"createdAt":"2026-09-06T09:36:48.940Z","updatedAt":"2026-09-06T11:57:32.667Z"},"graph":{"topology":"directed","semanticType":"authentication-flowchart","entryNodeId":"login_ui","nodes":{"login_ui":{"id":"login_ui","title":"用户看到登录界面","cardContent":"展示 A、B、C 三种登录入口。","notes":"","meta":{"owner":"frontend","flow":{"role":"start"}}},"choose_method":{"id":"choose_method","title":"用户选择登录方式","cardContent":"A 为本系统账号密码登录；B、C 为对应平台鉴权。","notes":"","meta":{"owner":"user","flow":{"role":"decision","mergeNodeId":"resolve_account"}}},"a_input":{"id":"a_input","title":"A：输入账号和密码","cardContent":"仅 A 方式在本系统收集账号和密码。","notes":"","meta":{"owner":"frontend","loginMethod":"A","collectsAccountAndPassword":true,"flow":{"role":"action"}}},"a_form_check":{"id":"a_form_check","title":"A：检查必填项与格式","cardContent":"前端检查输入是否完整、格式是否符合要求；不承担身份鉴权。","notes":"","meta":{"owner":"frontend","flow":{"role":"decision"}}},"a_input_error":{"id":"a_input_error","title":"提示输入问题","cardContent":"标出需要修正的输入，返回账号密码表单。","notes":"","meta":{"owner":"frontend","flow":{"role":"error"}}},"a_verify":{"id":"a_verify","title":"A：服务端校验账号密码","cardContent":"提交至本系统登录接口，由服务端验证账号及密码。","notes":"","meta":{"owner":"backend","flow":{"role":"decision"}}},"a_auth_error":{"id":"a_auth_error","title":"A：提示账号或密码错误","cardContent":"保留在 A 登录流程，允许重新输入。","notes":"","meta":{"owner":"frontend","flow":{"role":"error"}}},"b_authorize":{"id":"b_authorize","title":"B：发起平台 B 授权","cardContent":"通过平台 B 的登录 SDK 或授权流程取得待验证的平台凭证；本系统不收集平台密码。","notes":"","meta":{"owner":"platform_b","loginMethod":"B","collectsAccountAndPassword":false,"flow":{"role":"action"}}},"b_verify":{"id":"b_verify","title":"B：服务端调用平台 B API 鉴权","cardContent":"按平台 B 规范验证或交换凭证，并获取经验证的平台用户身份；不信任客户端自行宣称的身份。","notes":"","meta":{"owner":"backend","flow":{"role":"decision"}}},"c_authorize":{"id":"c_authorize","title":"C：发起平台 C 授权","cardContent":"通过平台 C 的登录 SDK 或授权流程取得待验证的平台凭证；本系统不收集平台密码。","n